<svg width="100%" height="548" viewBox="0 0 1920 548" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Friendly sky gradient -->
    <linearGradient id="skyGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
      <stop offset="40%" style="stop-color:#FFE066;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#90EE90;stop-opacity:1" />
    </linearGradient>
    
    <!-- Road gradient -->
    <linearGradient id="roadGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#9ACD32;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#32CD32;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Sky background -->
  <rect width="100%" height="548" fill="url(#skyGradient)"/>
  
  <!-- Fluffy white clouds -->
  <g opacity="0.8">
    <ellipse cx="150" cy="70" rx="45" ry="25" fill="white"/>
    <ellipse cx="180" cy="60" rx="35" ry="20" fill="white"/>
    <ellipse cx="200" cy="75" rx="30" ry="18" fill="white"/>
    
    <ellipse cx="1500" cy="80" rx="50" ry="28" fill="white"/>
    <ellipse cx="1540" cy="70" rx="40" ry="22" fill="white"/>
    <ellipse cx="1570" cy="85" rx="35" ry="20" fill="white"/>
    
    <ellipse cx="600" cy="50" rx="35" ry="20" fill="white"/>
    <ellipse cx="800" cy="65" rx="40" ry="23" fill="white"/>
    <ellipse cx="1000" cy="55" rx="30" ry="18" fill="white"/>
    <ellipse cx="1200" cy="60" rx="35" ry="20" fill="white"/>
  </g>
  
  <!-- Bright cheerful sun -->
  <g transform="translate(1700, 80)">
    <circle cx="0" cy="0" r="40" fill="#FFD700"/>
    <circle cx="0" cy="0" r="30" fill="#FFA500"/>
    <!-- Happy sun rays -->
    <g stroke="#FFD700" stroke-width="5" stroke-linecap="round">
      <path d="M0 -70 L0 -50"/>
      <path d="M49 -49 L35 -35"/>
      <path d="M70 0 L50 0"/>
      <path d="M49 49 L35 35"/>
      <path d="M0 70 L0 50"/>
      <path d="M-49 49 L-35 35"/>
      <path d="M-70 0 L-50 0"/>
      <path d="M-49 -49 L-35 -35"/>
    </g>
    <!-- Sun face -->
    <circle cx="-12" cy="-8" r="3" fill="#FF6B35"/>
    <circle cx="12" cy="-8" r="3" fill="#FF6B35"/>
    <path d="M-15 8 Q0 20 15 8" stroke="#FF6B35" stroke-width="3" fill="none" stroke-linecap="round"/>
  </g>
  
  <!-- Rolling green hills -->
  <path d="M0 320 Q200 300 400 320 T800 315 Q1000 310 1200 320 T1600 325 Q1800 320 1920 325 L1920 548 L0 548 Z" fill="url(#roadGradient)"/>
  
  <!-- Winding road -->
  <ellipse cx="960" cy="420" rx="800" ry="90" fill="#90EE90" opacity="0.7"/>
  <ellipse cx="960" cy="420" rx="700" ry="70" fill="#9ACD32"/>
  <ellipse cx="960" cy="420" rx="600" ry="50" fill="#32CD32" opacity="0.8"/>
  
  <!-- Road markings -->
  <rect x="940" y="410" width="40" height="4" rx="2" fill="white"/>
  <rect x="880" y="415" width="30" height="3" rx="1.5" fill="white"/>
  <rect x="1000" y="415" width="30" height="3" rx="1.5" fill="white"/>
  
  <!-- Friendly cartoon bus -->
  <g transform="translate(780, 260)">
    <!-- Bus shadow -->
    <ellipse cx="90" cy="130" rx="130" ry="18" fill="black" opacity="0.2"/>
    
    <!-- Main bus body -->
    <rect x="0" y="35" width="180" height="70" rx="15" fill="#FF6B35"/>
    <rect x="10" y="25" width="160" height="50" rx="12" fill="#2E86AB"/>
    
    <!-- Friendly bus windows -->
    <rect x="20" y="30" width="20" height="18" rx="4" fill="#87CEEB" opacity="0.95"/>
    <rect x="45" y="30" width="20" height="18" rx="4" fill="#87CEEB" opacity="0.95"/>
    <rect x="70" y="30" width="20" height="18" rx="4" fill="#87CEEB" opacity="0.95"/>
    <rect x="95" y="30" width="20" height="18" rx="4" fill="#87CEEB" opacity="0.95"/>
    <rect x="120" y="30" width="20" height="18" rx="4" fill="#87CEEB" opacity="0.95"/>
    <rect x="145" y="30" width="15" height="18" rx="4" fill="#87CEEB" opacity="0.95"/>
    
    <!-- Front windshield -->
    <rect x="160" y="40" width="15" height="30" rx="4" fill="#87CEEB" opacity="0.95"/>
    
    <!-- Bus doors -->
    <rect x="25" y="55" width="15" height="40" rx="3" fill="#1a1a1a"/>
    <rect x="50" y="55" width="15" height="40" rx="3" fill="#1a1a1a"/>
    <rect x="85" y="55" width="15" height="40" rx="3" fill="#1a1a1a"/>
    
    <!-- Happy bus wheels -->
    <circle cx="40" cy="110" r="15" fill="#1a1a1a"/>
    <circle cx="40" cy="110" r="10" fill="#4a4a4a"/>
    <circle cx="40" cy="110" r="6" fill="#666"/>
    <circle cx="40" cy="110" r="3" fill="#999"/>
    
    <circle cx="140" cy="110" r="15" fill="#1a1a1a"/>
    <circle cx="140" cy="110" r="10" fill="#4a4a4a"/>
    <circle cx="140" cy="110" r="6" fill="#666"/>
    <circle cx="140" cy="110" r="3" fill="#999"/>
    
    <!-- Bus headlights -->
    <circle cx="175" cy="50" r="4" fill="#FFD700"/>
    <circle cx="175" cy="65" r="4" fill="#FFD700"/>
    
    <!-- Bus details -->
    <rect x="165" y="75" width="8" height="3" rx="1.5" fill="#FFD700"/>
    <rect x="165" y="80" width="8" height="3" rx="1.5" fill="#FF4444"/>
    
    <!-- License plate -->
    <rect x="20" y="85" width="25" height="8" rx="2" fill="white"/>
    <text x="32" y="91" text-anchor="middle" font-family="Arial" font-size="5" fill="#333" font-weight="bold">VUI-01</text>
    
    <!-- Happy bus face -->
    <circle cx="30" cy="45" r="2" fill="white"/>
    <circle cx="50" cy="45" r="2" fill="white"/>
    <path d="M25 55 Q40 65 55 55" stroke="white" stroke-width="2" fill="none" stroke-linecap="round"/>
  </g>
  
  <!-- Large friendly "Chuyenxevui" text -->
  <text x="50%" y="160" text-anchor="middle" font-family="Arial, sans-serif" font-size="80" font-weight="bold" fill="white" stroke="#4CAF50" stroke-width="3">Chuyenxevui</text>
  
  <!-- Cheerful slogan -->
  <text x="200" y="480" font-family="Arial, sans-serif" font-size="36" font-weight="bold" fill="white" stroke="#FF6B35" stroke-width="1">Đặt vé nhanh - Tiện lợi - Đi ngay</text>
  
  <!-- Decorative elements -->
  <g opacity="0.6">
    <circle cx="100" cy="150" r="3" fill="#FFD700"/>
    <circle cx="1650" cy="200" r="4" fill="#4CAF50"/>
    <circle cx="200" cy="120" r="2" fill="#FF6B35"/>
    <circle cx="1550" cy="180" r="3" fill="#FFD700"/>
  </g>
</svg>
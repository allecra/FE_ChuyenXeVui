<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="300" fill="#F5F5DC"/>
  
  <!-- Sky gradient -->
  <defs>
    <linearGradient id="skyGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E0F6FF;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="buildingGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#4682B4;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2F4F4F;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Sky -->
  <rect width="400" height="150" fill="url(#skyGradient)"/>
  
  <!-- Ground -->
  <rect y="150" width="400" height="150" fill="#90EE90"/>
  
  <!-- Main Station Building -->
  <g transform="translate(100,80)">
    <!-- Main building -->
    <rect x="0" y="0" width="200" height="120" fill="url(#buildingGradient)"/>
    <!-- Roof -->
    <polygon points="0,0 100,−20 200,0" fill="#8B4513"/>
    <!-- Windows -->
    <rect x="20" y="20" width="25" height="30" fill="#87CEEB"/>
    <rect x="55" y="20" width="25" height="30" fill="#87CEEB"/>
    <rect x="90" y="20" width="25" height="30" fill="#87CEEB"/>
    <rect x="125" y="20" width="25" height="30" fill="#87CEEB"/>
    <rect x="160" y="20" width="25" height="30" fill="#87CEEB"/>
    
    <!-- Lower windows -->
    <rect x="20" y="70" width="25" height="30" fill="#87CEEB"/>
    <rect x="55" y="70" width="25" height="30" fill="#87CEEB"/>
    <rect x="125" y="70" width="25" height="30" fill="#87CEEB"/>
    <rect x="160" y="70" width="25" height="30" fill="#87CEEB"/>
    
    <!-- Main entrance -->
    <rect x="85" y="60" width="30" height="60" fill="#8B4513"/>
    <rect x="90" y="65" width="20" height="40" fill="#654321"/>
    
    <!-- Station sign -->
    <rect x="60" y="10" width="80" height="15" fill="white" rx="2"/>
    <text x="100" y="20" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="#2F4F4F">BẾN XE AN SƯƠNG</text>
  </g>
  
  <!-- Buses parked -->
  <g transform="translate(50,180)">
    <rect x="0" y="0" width="80" height="35" rx="5" fill="#FF6B35"/>
    <rect x="5" y="5" width="12" height="10" fill="#87CEEB"/>
    <rect x="20" y="5" width="12" height="10" fill="#87CEEB"/>
    <rect x="35" y="5" width="12" height="10" fill="#87CEEB"/>
    <rect x="50" y="5" width="12" height="10" fill="#87CEEB"/>
    <circle cx="15" cy="40" r="6" fill="#333"/>
    <circle cx="65" cy="40" r="6" fill="#333"/>
  </g>
  
  <g transform="translate(150,185)">
    <rect x="0" y="0" width="75" height="30" rx="4" fill="#32CD32"/>
    <rect x="5" y="4" width="10" height="8" fill="#87CEEB"/>
    <rect x="18" y="4" width="10" height="8" fill="#87CEEB"/>
    <rect x="31" y="4" width="10" height="8" fill="#87CEEB"/>
    <rect x="44" y="4" width="10" height="8" fill="#87CEEB"/>
    <circle cx="12" cy="35" r="5" fill="#333"/>
    <circle cx="63" cy="35" r="5" fill="#333"/>
  </g>
  
  <g transform="translate(250,180)">
    <rect x="0" y="0" width="85" height="35" rx="5" fill="#4169E1"/>
    <rect x="5" y="5" width="12" height="10" fill="#87CEEB"/>
    <rect x="20" y="5" width="12" height="10" fill="#87CEEB"/>
    <rect x="35" y="5" width="12" height="10" fill="#87CEEB"/>
    <rect x="50" y="5" width="12" height="10" fill="#87CEEB"/>
    <rect x="65" y="5" width="12" height="10" fill="#87CEEB"/>
    <circle cx="15" cy="40" r="6" fill="#333"/>
    <circle cx="70" cy="40" r="6" fill="#333"/>
  </g>
  
  <!-- Trees -->
  <g transform="translate(20,120)">
    <rect x="0" y="25" width="8" height="50" fill="#8B4513"/>
    <circle cx="4" cy="25" r="18" fill="#228B22"/>
  </g>
  
  <g transform="translate(360,110)">
    <rect x="0" y="30" width="10" height="60" fill="#8B4513"/>
    <circle cx="5" cy="30" r="22" fill="#228B22"/>
  </g>
  
  <!-- Station name -->
  <text x="200" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#2F4F4F">Bến xe An Sương</text>
  <text x="200" y="60" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#666">Khu vực phía Tây TP.HCM</text>
  
  <!-- Platform indicators -->
  <rect x="80" y="220" width="40" height="20" fill="#FFD700" rx="3"/>
  <text x="100" y="232" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="#333">Tuyến 1</text>
  
  <rect x="140" y="220" width="40" height="20" fill="#FFD700" rx="3"/>
  <text x="160" y="232" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="#333">Tuyến 2</text>
  
  <rect x="200" y="220" width="40" height="20" fill="#FFD700" rx="3"/>
  <text x="220" y="232" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="#333">Tuyến 3</text>
</svg>
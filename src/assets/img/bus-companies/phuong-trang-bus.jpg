<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="300" fill="#F0F8FF"/>
  
  <!-- Sky gradient -->
  <defs>
    <linearGradient id="skyGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E0F6FF;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="busGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FF6B35;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FF4500;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Sky -->
  <rect width="400" height="180" fill="url(#skyGradient)"/>
  
  <!-- Ground -->
  <rect y="180" width="400" height="120" fill="#90EE90"/>
  
  <!-- Road -->
  <rect y="200" width="400" height="40" fill="#666666"/>
  <rect y="215" width="400" height="4" fill="white"/>
  
  <!-- Main Bus -->
  <g transform="translate(120,150)">
    <!-- Bus body -->
    <rect x="0" y="0" width="120" height="45" rx="8" fill="url(#busGradient)"/>
    <!-- Front -->
    <rect x="115" y="5" width="8" height="35" rx="4" fill="#FF4500"/>
    <!-- Windows -->
    <rect x="8" y="8" width="18" height="15" fill="#87CEEB"/>
    <rect x="30" y="8" width="18" height="15" fill="#87CEEB"/>
    <rect x="52" y="8" width="18" height="15" fill="#87CEEB"/>
    <rect x="74" y="8" width="18" height="15" fill="#87CEEB"/>
    <rect x="96" y="8" width="15" height="15" fill="#87CEEB"/>
    <!-- Door -->
    <rect x="25" y="25" width="12" height="20" fill="#333"/>
    <!-- Wheels -->
    <circle cx="20" cy="50" r="10" fill="#333"/>
    <circle cx="100" cy="50" r="10" fill="#333"/>
    <circle cx="20" cy="50" r="6" fill="#666"/>
    <circle cx="100" cy="50" r="6" fill="#666"/>
    <!-- Company logo area -->
    <rect x="40" y="28" width="40" height="12" fill="white" rx="2"/>
    <text x="60" y="36" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" font-weight="bold" fill="#FF6B35">PHƯƠNG TRANG</text>
  </g>
  
  <!-- Background buses -->
  <g transform="translate(50,160)" opacity="0.7">
    <rect x="0" y="0" width="80" height="30" rx="5" fill="#FF8C69"/>
    <rect x="5" y="5" width="12" height="10" fill="#87CEEB"/>
    <rect x="20" y="5" width="12" height="10" fill="#87CEEB"/>
    <rect x="35" y="5" width="12" height="10" fill="#87CEEB"/>
    <rect x="50" y="5" width="12" height="10" fill="#87CEEB"/>
    <circle cx="15" cy="35" r="6" fill="#333"/>
    <circle cx="65" cy="35" r="6" fill="#333"/>
  </g>
  
  <g transform="translate(280,165)" opacity="0.6">
    <rect x="0" y="0" width="70" height="25" rx="4" fill="#FF7F50"/>
    <rect x="5" y="4" width="10" height="8" fill="#87CEEB"/>
    <rect x="18" y="4" width="10" height="8" fill="#87CEEB"/>
    <rect x="31" y="4" width="10" height="8" fill="#87CEEB"/>
    <rect x="44" y="4" width="10" height="8" fill="#87CEEB"/>
    <circle cx="12" cy="30" r="5" fill="#333"/>
    <circle cx="58" cy="30" r="5" fill="#333"/>
  </g>
  
  <!-- Trees -->
  <g transform="translate(30,140)">
    <rect x="0" y="25" width="8" height="40" fill="#8B4513"/>
    <circle cx="4" cy="25" r="18" fill="#228B22"/>
  </g>
  
  <g transform="translate(350,130)">
    <rect x="0" y="30" width="10" height="50" fill="#8B4513"/>
    <circle cx="5" cy="30" r="22" fill="#228B22"/>
  </g>
  
  <!-- Company name -->
  <text x="200" y="50" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#FF6B35">Phương Trang</text>
  <text x="200" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#666">Xe khách chất lượng cao</text>
  
  <!-- Stars for rating -->
  <g transform="translate(160,85)">
    <polygon points="10,2 12,8 18,8 13,12 15,18 10,14 5,18 7,12 2,8 8,8" fill="#FFD700"/>
    <polygon points="30,2 32,8 38,8 33,12 35,18 30,14 25,18 27,12 22,8 28,8" fill="#FFD700"/>
    <polygon points="50,2 52,8 58,8 53,12 55,18 50,14 45,18 47,12 42,8 48,8" fill="#FFD700"/>
    <polygon points="70,2 72,8 78,8 73,12 75,18 70,14 65,18 67,12 62,8 68,8" fill="#FFD700"/>
    <polygon points="90,2 92,8 98,8 93,12 95,18 90,14 85,18 87,12 82,8 88,8" fill="#FFD700"/>
  </g>
</svg>
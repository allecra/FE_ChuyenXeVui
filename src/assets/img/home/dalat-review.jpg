<svg width="400" height="200" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="dalatGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#81C784;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#66BB6A;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="200" fill="url(#dalatGrad)"/>
  
  <!-- Hills -->
  <path d="M0 100 Q100 80 200 90 T400 85 L400 200 L0 200 Z" fill="#2E7D32" opacity="0.8"/>
  <path d="M0 120 Q80 100 160 110 T320 105 L400 110 L400 200 L0 200 Z" fill="#388E3C" opacity="0.7"/>
  <path d="M50 140 Q150 125 250 135 T400 130 L400 200 L50 200 Z" fill="#4CAF50" opacity="0.6"/>
  
  <!-- Pine trees -->
  <polygon points="80,140 85,120 90,140" fill="#1B5E20"/>
  <polygon points="78,135 87,115 96,135" fill="#2E7D32"/>
  <rect x="84" y="140" width="2" height="8" fill="#5D4037"/>
  
  <polygon points="150,130 155,110 160,130" fill="#1B5E20"/>
  <polygon points="148,125 157,105 166,125" fill="#2E7D32"/>
  <rect x="154" y="130" width="2" height="8" fill="#5D4037"/>
  
  <polygon points="220,135 225,115 230,135" fill="#1B5E20"/>
  <polygon points="218,130 227,110 236,130" fill="#2E7D32"/>
  <rect x="224" y="135" width="2" height="8" fill="#5D4037"/>
  
  <polygon points="300,125 305,105 310,125" fill="#1B5E20"/>
  <polygon points="298,120 307,100 316,120" fill="#2E7D32"/>
  <rect x="304" y="125" width="2" height="8" fill="#5D4037"/>
  
  <!-- Lake -->
  <ellipse cx="200" cy="160" rx="80" ry="20" fill="#1976D2" opacity="0.6"/>
  <ellipse cx="200" cy="158" rx="75" ry="18" fill="#2196F3" opacity="0.4"/>
  
  <!-- Flowers -->
  <circle cx="120" cy="150" r="3" fill="#E91E63"/>
  <circle cx="180" cy="145" r="3" fill="#FF5722"/>
  <circle cx="260" cy="155" r="3" fill="#9C27B0"/>
  <circle cx="320" cy="148" r="3" fill="#FF9800"/>
  
  <!-- Mist -->
  <ellipse cx="150" cy="90" rx="40" ry="15" fill="white" opacity="0.4"/>
  <ellipse cx="280" cy="85" rx="35" ry="12" fill="white" opacity="0.3"/>
  
  <!-- Text overlay -->
  <rect x="0" y="150" width="400" height="50" fill="black" opacity="0.3"/>
</svg>
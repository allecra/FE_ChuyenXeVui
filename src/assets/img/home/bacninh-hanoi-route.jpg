<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="300" fill="#E8F5E8"/>
  
  <!-- Sky gradient -->
  <defs>
    <linearGradient id="skyGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E0F6FF;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="roadGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#666666;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#444444;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Sky -->
  <rect width="400" height="150" fill="url(#skyGradient)"/>
  
  <!-- Ground -->
  <rect y="150" width="400" height="150" fill="#90EE90"/>
  
  <!-- Road -->
  <polygon points="0,200 400,180 400,220 0,240" fill="url(#roadGradient)"/>
  
  <!-- Road markings -->
  <rect x="50" y="205" width="30" height="4" fill="white"/>
  <rect x="120" y="203" width="30" height="4" fill="white"/>
  <rect x="190" y="201" width="30" height="4" fill="white"/>
  <rect x="260" y="199" width="30" height="4" fill="white"/>
  <rect x="330" y="197" width="30" height="4" fill="white"/>
  
  <!-- Bus -->
  <g transform="translate(150,170)">
    <!-- Bus body -->
    <rect x="0" y="0" width="80" height="35" rx="5" fill="#FF6B35"/>
    <!-- Windows -->
    <rect x="5" y="5" width="15" height="12" fill="#87CEEB"/>
    <rect x="25" y="5" width="15" height="12" fill="#87CEEB"/>
    <rect x="45" y="5" width="15" height="12" fill="#87CEEB"/>
    <rect x="65" y="5" width="10" height="12" fill="#87CEEB"/>
    <!-- Wheels -->
    <circle cx="15" cy="40" r="8" fill="#333"/>
    <circle cx="65" cy="40" r="8" fill="#333"/>
    <circle cx="15" cy="40" r="5" fill="#666"/>
    <circle cx="65" cy="40" r="5" fill="#666"/>
  </g>
  
  <!-- Trees -->
  <g transform="translate(50,120)">
    <rect x="0" y="20" width="8" height="30" fill="#8B4513"/>
    <circle cx="4" cy="20" r="15" fill="#228B22"/>
  </g>
  
  <g transform="translate(320,110)">
    <rect x="0" y="25" width="10" height="35" fill="#8B4513"/>
    <circle cx="5" cy="25" r="18" fill="#228B22"/>
  </g>
  
  <!-- Buildings in distance -->
  <rect x="280" y="100" width="20" height="50" fill="#B0B0B0"/>
  <rect x="305" y="90" width="25" height="60" fill="#A0A0A0"/>
  <rect x="335" y="95" width="18" height="55" fill="#B0B0B0"/>
  
  <!-- Route text -->
  <text x="200" y="50" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#2E8B57">Bắc Ninh - Hà Nội</text>
  <text x="200" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#666">Tuyến đường ngắn, tiện lợi</text>
  
  <!-- Distance marker -->
  <circle cx="350" cy="40" r="20" fill="#FFA901" opacity="0.9"/>
  <text x="350" y="35" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="white">30</text>
  <text x="350" y="47" text-anchor="middle" font-family="Arial, sans-serif" font-size="8" fill="white">km</text>
</svg>
<svg width="400" height="200" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="danangGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4CAF50;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#388E3C;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="200" fill="url(#danangGrad)"/>
  
  <!-- Mountains -->
  <path d="M0 80 L60 40 L120 60 L180 30 L240 50 L300 35 L360 45 L400 40 L400 200 L0 200 Z" fill="#2E7D32" opacity="0.8"/>
  <path d="M20 100 L80 60 L140 80 L200 50 L260 70 L320 55 L380 65 L400 60 L400 200 L20 200 Z" fill="#388E3C" opacity="0.7"/>
  
  <!-- Dragon Bridge area -->
  <rect x="150" y="120" width="100" height="4" fill="#FFD700"/>
  <rect x="140" y="118" width="4" height="8" fill="#8D6E63"/>
  <rect x="256" y="118" width="4" height="8" fill="#8D6E63"/>
  
  <!-- Dragon head -->
  <path d="M250 115 Q260 110 270 115 Q265 120 255 118 Z" fill="#F44336"/>
  <circle cx="262" cy="113" r="2" fill="#FFD700"/>
  
  <!-- River -->
  <path d="M0 130 Q100 125 200 130 T400 130 L400 140 Q300 135 200 140 T0 140 Z" fill="#1976D2" opacity="0.6"/>
  
  <!-- Modern buildings -->
  <rect x="80" y="90" width="15" height="40" fill="#2196F3"/>
  <rect x="100" y="85" width="20" height="45" fill="#1976D2"/>
  <rect x="125" y="95" width="12" height="35" fill="#2196F3"/>
  
  <rect x="280" y="80" width="25" height="50" fill="#FF9800"/>
  <rect x="310" y="75" width="18" height="55" fill="#FFC107"/>
  <rect x="335" y="85" width="22" height="45" fill="#FF9800"/>
  
  <!-- Ba Na Hills cable car -->
  <path d="M50 60 L350 80" stroke="#424242" stroke-width="1"/>
  <rect x="200" y="75" width="8" height="6" fill="#616161"/>
  
  <!-- Beach -->
  <rect x="0" y="145" width="400" height="55" fill="#FFF8E1"/>
  
  <!-- Waves -->
  <path d="M0 140 Q50 138 100 140 T200 140 T300 140 T400 140 L400 145 Q300 143 200 143 T0 145 Z" fill="#0288D1" opacity="0.4"/>
  
  <!-- Text overlay -->
  <rect x="0" y="150" width="400" height="50" fill="black" opacity="0.3"/>
</svg>
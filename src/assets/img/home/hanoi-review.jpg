<svg width="400" height="200" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="hanoiGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#66BB6A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4CAF50;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="200" fill="url(#hanoiGrad)"/>
  
  <!-- Ho Chi Minh Mausoleum -->
  <rect x="180" y="80" width="40" height="60" fill="#8D6E63"/>
  <rect x="175" y="75" width="50" height="8" fill="#5D4037"/>
  <rect x="170" y="70" width="60" height="8" fill="#5D4037"/>
  <rect x="185" y="85" width="30" height="20" fill="#37474F"/>
  <rect x="190" y="90" width="20" height="15" fill="#263238"/>
  
  <!-- Columns -->
  <rect x="185" y="105" width="4" height="35" fill="#BDBDBD"/>
  <rect x="195" y="105" width="4" height="35" fill="#BDBDBD"/>
  <rect x="205" y="105" width="4" height="35" fill="#BDBDBD"/>
  <rect x="211" y="105" width="4" height="35" fill="#BDBDBD"/>
  
  <!-- Steps -->
  <rect x="175" y="140" width="50" height="4" fill="#9E9E9E"/>
  <rect x="170" y="144" width="60" height="4" fill="#757575"/>
  <rect x="165" y="148" width="70" height="4" fill="#616161"/>
  
  <!-- Trees around -->
  <circle cx="120" cy="130" r="15" fill="#2E7D32"/>
  <rect x="118" y="130" width="4" height="20" fill="#5D4037"/>
  
  <circle cx="280" cy="125" r="18" fill="#2E7D32"/>
  <rect x="278" y="125" width="4" height="25" fill="#5D4037"/>
  
  <circle cx="80" cy="140" r="12" fill="#388E3C"/>
  <rect x="78" y="140" width="4" height="15" fill="#5D4037"/>
  
  <circle cx="320" cy="135" r="14" fill="#388E3C"/>
  <rect x="318" y="135" width="4" height="18" fill="#5D4037"/>
  
  <!-- Vietnamese flags -->
  <rect x="140" y="60" width="2" height="25" fill="#5D4037"/>
  <rect x="142" y="60" width="12" height="8" fill="#F44336"/>
  <polygon points="148,64 154,64 151,67" fill="#FFD700"/>
  
  <rect x="250" y="65" width="2" height="25" fill="#5D4037"/>
  <rect x="252" y="65" width="12" height="8" fill="#F44336"/>
  <polygon points="258,69 264,69 261,72" fill="#FFD700"/>
  
  <!-- Pathway -->
  <rect x="0" y="155" width="400" height="45" fill="#8D6E63" opacity="0.6"/>
  <rect x="50" y="160" width="300" height="35" fill="#A1887F" opacity="0.4"/>
  
  <!-- Text overlay -->
  <rect x="0" y="150" width="400" height="50" fill="black" opacity="0.3"/>
</svg>
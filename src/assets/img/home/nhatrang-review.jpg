  <!-- Ocean waves -->
  <path d="M0 130 Q50 125 100 130 T200 130 T300 130 T400 130 L400 150 Q300 145 200 150 T0 150 Z" fill="#0277BD" opacity="0.8"/>
  <path d="M0 135 Q40 132 80 135 T160 135 T240 135 T320 135 T400 135 L400 145 Q320 142 240 142 T80 142 T0 145 Z" fill="#0288D1" opacity="0.6"/>
  
  <!-- Hotels and buildings -->
  <rect x="50" y="100" width="20" height="50" fill="#FF9800"/>
  <rect x="75" y="90" width="25" height="60" fill="#FFC107"/>
  <rect x="105" y="95" width="18" height="55" fill="#FF9800"/>
  <rect x="130" y="85" width="30" height="65" fill="#FFC107"/>
  <rect x="165" y="105" width="15" height="45" fill="#FF9800"/>
  
  <rect x="220" y="80" width="35" height="70" fill="#E91E63"/>
  <rect x="260" y="90" width="25" height="60" fill="#F06292"/>
  <rect x="290" y="75" width="40" height="75" fill="#E91E63"/>
  <rect x="335" y="95" width="20" height="55" fill="#F06292"/>
  
  <!-- Windows -->
  <rect x="55" y="110" width="3" height="3" fill="#FFD54F"/>
  <rect x="62" y="110" width="3" height="3" fill="#FFD54F"/>
  <rect x="55" y="120" width="3" height="3" fill="#FFD54F"/>
  <rect x="62" y="120" width="3" height="3" fill="#FFD54F"/>
  
  <rect x="225" y="90" width="4" height="4" fill="#FFD54F"/>
  <rect x="235" y="90" width="4" height="4" fill="#FFD54F"/>
  <rect x="245" y="90" width="4" height="4" fill="#FFD54F"/>
  
  <!-- Palm trees -->
  <rect x="180" y="130" width="3" height="20" fill="#5D4037"/>
  <ellipse cx="181.5" cy="125" rx="8" ry="6" fill="#2E7D32"/>
  <rect x="200" y="135" width="3" height="15" fill="#5D4037"/>
  <ellipse cx="201.5" cy="130" rx="6" ry="5" fill="#2E7D32"/>
  

<svg width="400" height="200" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="phanthietGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFB74D;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FF9800;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="200" fill="url(#phanthietGrad)"/>
  
  <!-- Sand dunes -->
  <path d="M0 120 Q80 100 160 110 T320 105 L400 110 L400 200 L0 200 Z" fill="#FFC107" opacity="0.8"/>
  <path d="M50 140 Q130 125 210 135 T370 130 L400 135 L400 200 L50 200 Z" fill="#FFD54F" opacity="0.7"/>
  <path d="M100 160 Q180 150 260 155 T400 155 L400 200 L100 200 Z" fill="#FFECB3" opacity="0.6"/>
  
  <!-- Ocean -->
  <path d="M0 140 Q50 135 100 140 T200 140 T300 140 T400 140 L400 150 Q300 145 200 145 T0 150 Z" fill="#0277BD" opacity="0.6"/>
  
  <!-- Palm trees -->
  <rect x="120" y="130" width="3" height="25" fill="#5D4037"/>
  <ellipse cx="121.5" cy="125" rx="10" ry="8" fill="#2E7D32"/>
  <rect x="180" y="135" width="3" height="20" fill="#5D4037"/>
  <ellipse cx="181.5" cy="130" rx="8" ry="6" fill="#2E7D32"/>
  <rect x="250" y="125" width="3" height="30" fill="#5D4037"/>
  <ellipse cx="251.5" cy="120" rx="12" ry="9" fill="#2E7D32"/>
  
  <!-- Fishing boats -->
  <ellipse cx="80" cy="145" rx="12" ry="4" fill="#8D6E63"/>
  <rect x="78" y="140" width="4" height="8" fill="#5D4037"/>
  <path d="M76 140 L82 140 L80 135 Z" fill="#2196F3"/>
  
  <ellipse cx="320" cy="148" rx="10" ry="3" fill="#795548"/>
  <rect x="318" y="143" width="4" height="7" fill="#5D4037"/>
  <path d="M316 143 L322 143 L320 138 Z" fill="#F44336"/>
  
  <!-- Sand patterns -->
  <path d="M150 170 Q200 165 250 170" stroke="#FFB74D" stroke-width="2" fill="none" opacity="0.5"/>
  <path d="M100 180 Q150 175 200 180" stroke="#FFB74D" stroke-width="2" fill="none" opacity="0.5"/>
  <path d="M250 185 Q300 180 350 185" stroke="#FFB74D" stroke-width="2" fill="none" opacity="0.5"/>
  
  <!-- Sunset/sunrise -->
  <circle cx="350" cy="50" r="25" fill="#FF5722" opacity="0.8"/>
  <circle cx="350" cy="50" r="20" fill="#FF9800" opacity="0.6"/>
  
  <!-- Clouds -->
  <ellipse cx="100" cy="40" rx="20" ry="10" fill="white" opacity="0.6"/>
  <ellipse cx="250" cy="35" rx="25" ry="12" fill="white" opacity="0.5"/>
  
  <!-- Text overlay -->
  <rect x="0" y="150" width="400" height="50" fill="black" opacity="0.3"/>
</svg>
<svg width="400" height="200" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="quynhonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#42A5F5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1E88E5;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="200" fill="url(#quynhonGrad)"/>
  
  <!-- Beach curve -->
  <path d="M0 140 Q100 130 200 135 T400 140 L400 200 L0 200 Z" fill="#FFF8E1"/>
  
  <!-- Ocean -->
  <path d="M0 120 Q50 115 100 120 T200 120 T300 120 T400 120 L400 140 Q300 135 200 135 T0 140 Z" fill="#0277BD" opacity="0.8"/>
  <path d="M0 125 Q40 122 80 125 T160 125 T240 125 T320 125 T400 125 L400 135 Q320 132 240 132 T80 132 T0 135 Z" fill="#0288D1" opacity="0.6"/>
  
  <!-- Fishing boats -->
  <ellipse cx="80" cy="125" rx="12" ry="4" fill="#8D6E63"/>
  <rect x="78" y="120" width="4" height="8" fill="#5D4037"/>
  <path d="M76 120 L84 120 L82 115 Z" fill="#F44336"/>
  
  <ellipse cx="150" cy="128" rx="10" ry="3" fill="#795548"/>
  <rect x="148" y="123" width="4" height="7" fill="#5D4037"/>
  <path d="M146 123 L152 123 L150 118 Z" fill="#2196F3"/>
  
  <!-- Coastal rocks -->
  <ellipse cx="300" cy="145" rx="20" ry="8" fill="#455A64"/>
  <ellipse cx="320" cy="148" rx="15" ry="6" fill="#37474F"/>
  <ellipse cx="340" cy="142" rx="18" ry="7" fill="#455A64"/>
  
  <!-- Seagulls -->
  <path d="M120 60 Q125 58 130 60 Q125 62 120 60" fill="white"/>
  <path d="M200 70 Q205 68 210 70 Q205 72 200 70" fill="white"/>
  <path d="M280 55 Q285 53 290 55 Q285 57 280 55" fill="white"/>
  
  <!-- Clouds -->
  <ellipse cx="100" cy="40" rx="25" ry="12" fill="white" opacity="0.7"/>
  <ellipse cx="300" cy="35" rx="30" ry="15" fill="white" opacity="0.6"/>
  
  <!-- Text overlay -->
  <rect x="0" y="150" width="400" height="50" fill="black" opacity="0.3"/>
</svg>